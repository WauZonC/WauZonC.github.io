# 统一换行为 LF，避免 Windows CRLF 造成整文件 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.mp4 binary
*.mp3 binary

# 锁文件折叠 diff，减少噪音
pnpm-lock.yaml -diff merge=ours
package-lock.json -diff merge=ours

# 构建产物标记为生成文件
dist/** linguist-generated=true
