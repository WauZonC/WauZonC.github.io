# ---------- 依赖与构建产物 ----------
node_modules/
dist/
.output/
.astro/
.vercel/
.netlify/
.cache/

# ---------- 锁文件例外说明 ----------
# pnpm-lock.yaml / package-lock.json 必须入库，请勿在此忽略

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example

# ---------- 编辑器 / IDE 私有配置 ----------
.obsidian/
.claude/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- P4 内容取材与人工审批（本地临时目录，绝不入库） ----------
# 阶段一产出的「待审批内容」包含个人隐私素材（联系方式/成绩/学号等），
# 仅供人工逐项审阅与删改；严禁 `git add -f p4-review/`。
p4-review/

# ---------- 日志与临时文件 ----------
*.log
npm-debug.log*
pnpm-debug.log*
tmp/
temp/
*.tmp
*.bak

# ---------- 原始照片（带 EXIF/GPS，绝不入库） ----------
# 根目录的这张照片是用户自拍的原始文件，EXIF 里带 GPS 坐标
# （36°02′59.4″N / 120°20′36.0″E）、拍摄时间与设备型号。本仓库是公开的，
# 一旦提交即等于公开拍摄地点，而公开仓库的推送不可逆。
# demo/ 里用的是另存的副本（已缩到 2560×1920 并清空全部 EXIF），那个**要**入库。
# 因此这里精确忽略根目录的这一个文件，不影响 demo/ 下的同名副本。
/backgroud_chunk.jpg
