!.vscode/settings.json.example
.idea/

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- P4 内容取材与人工审批（本地临时目录，绝不入库） ----------
# 阶段一产出的「待审批内容」包含个人隐私素材（联系方式/成绩/学号等），
# 仅供人工逐项审阅与删改；严禁 `git add -f p4-review/`。
p4-review/

# ---------- 日志与临时文件 ----------
*.log
npm-debug.log*
pnpm-debug.log*
tmp/
temp/
*.tmp
*.bak
