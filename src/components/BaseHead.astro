---
import { ui, type Lang } from '../i18n/ui';
import {
  BACKGROUND_CONFIG_ID,
  backgroundInlineScript,
  serializeBackgroundData,
  buildTimeBackgroundUrl,
} from '../backgrounds/runtime';
import { BACKGROUND_CONFIG } from '../backgrounds/config';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  lang: Lang;
  /**
   * 另一语言**同一页面**的地址。
   * 只有在确实存在 1:1 译文时才传；传了才输出双向 hreflang（ADR-10 约束 2）。
   * 语言按钮的「回退地址」（目标语言没有对应内容时）**不要**走这个参数。
   */
  altHref?: string;
}

const { title, description, ogType = 'website', lang, altHref } = Astro.props;

const t = ui[lang];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;

// altHref 由调用方给出，通常是 `/en/...` 这样的站内相对路径；
// hreflang / x-default 必须是绝对 URL（相对地址对搜索引擎无意义），故统一补全。
const toAbsolute = (href: string | URL): string | URL =>
  Astro.site ? new URL(href, Astro.site) : href;

// hreflang 互指：只有这一对页面都存在时才输出双向链接
const zhHref = lang === 'zh' ? canonical : altHref && toAbsolute(altHref);
const enHref = lang === 'en' ? canonical : altHref && toAbsolute(altHref);
const hasBoth = Boolean(zhHref && enHref);
// x-default 优先指向中文版；中文版不存在时退回当前页面
const xDefault = zhHref ?? canonical;

/**
 * 背景（ADR-12 / M-4）：构建期先算出「构建机当天」的那张照片，写进内联 <style>。
 *   · 无 JS 环境就显示它（必须有确定值，不能留空）
 *   · 构建机与访客同一天时，运行期脚本不会覆写它 —— 不闪图、也不多发一次请求
 */
const bakedBg = buildTimeBackgroundUrl(new Date());
const bgDataJson = serializeBackgroundData();
const bgScript = backgroundInlineScript();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!--
  背景照片池数据（ADR-12）。必须是 type="application/json"：内容是**数据**、
  不会被执行，标签内的 `<` 已在 serializeBackgroundData() 里转成 \u003c。
  运行期脚本只读它，不发起任何网络请求 —— 首屏因此不会「等清单」而闪错图。
-->
<script type="application/json" id={BACKGROUND_CONFIG_ID} set:html={bgDataJson}></script>

<!--
  背景：先按**构建机当天**的映射结果铺底（无 JS 也能看到确定的照片），
  再由下面的运行期脚本按**客户端本地日期**覆盖。
  --photo-fade 来自 config.ts 的 fadeMs，与 ThemeToggle 的 theme-color 无关。
-->
<style is:inline set:html={`:root{--bg-photo:url('${bakedBg.src}');--photo-fade:${BACKGROUND_CONFIG.fadeMs}ms}`}></style>
<!--
  运行期脚本（ADR-12 / M-4）。必须 is:inline：
    1) Astro 默认会把内联脚本打包成模块并产出 .js 文件，那会打破 R3（dist 内 .js 为 0）；
    2) 必须同步、阻塞地在首次绘制前执行完，否则会先闪一张错的背景再换。
  内容由 src/backgrounds/runtime.ts 在构建期生成（其中日期映射函数的源码与 TS 版本同源，
  一致性由 tmp/test_bg_map.mjs 逐日断言）。
-->
<script is:inline set:html={bgScript}></script>

<!--
  移动端地址栏配色：与 global.css 的 body 底色一致（ADR-11 后背景是压暗的照片，
  浅/深两态都偏深）。ADR-12 起主题切换静默，恒为浅色态这一条；
  ThemeToggle 的脚本（保留未删）一旦被重新启用，会把它换成单一 meta。
-->
<meta name="theme-color" content="#1b2a3d" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0d1420" media="(prefers-color-scheme: dark)" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- 双语互指（ADR-10）：x-default 优先中文版；仅单侧存在时不输出另外两条 -->
<link rel="alternate" hreflang="x-default" href={xDefault} />
{
  hasBoth && (
    <>
      <link rel="alternate" hreflang="zh-CN" href={zhHref} />
      <link rel="alternate" hreflang="en" href={enHref} />
    </>
  )
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={t.ogSiteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
{
  hasBoth && lang === 'zh' && <meta property="og:locale:alternate" content="en_US" />
}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
