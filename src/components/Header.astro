---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import { getLangFromPath, stripLang, ui, withLang, type Lang } from '../i18n/ui';

interface Props {
  /** 由 BaseLayout 传入；缺省时按路径自动判断（/en/ 前缀 = 英文） */
  lang?: Lang;
  /** 目标语言缺少对应页面时的语言按钮回退地址（ADR-10 约束 1） */
  altHref?: string;
}

const pathname = Astro.url.pathname;
const lang: Lang = Astro.props.lang ?? getLangFromPath(pathname);
const t = ui[lang];

// 导航文案与地址都随语言走：中文页 -> 中文路径，英文页 -> /en/ 前缀
const navItems = [
  { path: '/', label: t.nav.home },
  { path: '/about/', label: t.nav.about },
  { path: '/blog/', label: t.nav.blog },
  { path: '/projects/', label: t.nav.projects },
].map((item) => ({ ...item, href: withLang(item.path, lang) }));

// 当前高亮在「去掉语言前缀」的路径上判断，中英两套导航共用同一份逻辑
const bare = stripLang(pathname);

function isCurrent(path: string): boolean {
  if (path === '/') {
    return bare === '/';
  }
  return bare === path || bare.startsWith(path);
}

const homeHref = withLang('/', lang);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-title" href={homeHref}>{t.siteName}</a>

    <div class="header-actions">
      <nav class="site-nav" aria-label={t.navLabel}>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-toggles">
        <LangSwitch lang={lang} pathname={pathname} altHref={Astro.props.altHref} />
        <ThemeToggle lang={lang} />
      </div>
    </div>
  </div>
</header>

<style>
  /* 粘性玻璃导航栏：材质令牌与 global.css 的 .glass 一致（P3 / ADR-7） */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--glass);
    border-bottom: 1px solid var(--glass-border);
    -webkit-backdrop-filter: blur(var(--blur)) saturate(140%);
    backdrop-filter: blur(var(--blur)) saturate(140%);
  }

  @supports not ((backdrop-filter: blur(2px)) or (-webkit-backdrop-filter: blur(2px))) {
    .site-header {
      background: var(--glass-solid);
    }
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    padding-block: 0.75rem;
  }

  .site-title {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: var(--fg);
  }

  /* 导航与右侧两个切换按钮同组，窄屏时整组换行（避免撑出横向滚动） */
  .header-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem 0.75rem;
    min-width: 0;
  }

  .header-toggles {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: block;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--fg);
    background: var(--glass-tint);
  }

  .site-nav a[aria-current='page'] {
    color: var(--fg);
    background: var(--glass-tint);
    font-weight: 600;
  }

  /* 窄屏不留白浪费：品牌与导航各占一行时左对齐堆叠 */
  @media (max-width: 640px) {
    .header-inner {
      padding-block: 0.6rem;
    }

    .site-nav a {
      padding: 0.2rem 0.65rem;
      font-size: 0.86rem;
    }
  }
</style>
