---
import ThemeToggle from './ThemeToggle.astro';
import BackgroundButton from './BackgroundButton.astro';
import LangSwitch from './LangSwitch.astro';
import { getLangFromPath, stripLang, ui, withLang, type Lang } from '../i18n/ui';
import { THEME_TOGGLE_ENABLED } from '../backgrounds/config';
import { BACKGROUND_IDS } from '../backgrounds/generated';

interface Props {
  /** 由 BaseLayout 传入；缺省时按路径自动判断（/en/ 前缀 = 英文） */
  lang?: Lang;
  /** 目标语言缺少对应页面时的语言按钮回退地址（ADR-10 约束 1） */
  altHref?: string;
}

const pathname = Astro.url.pathname;
const lang: Lang = Astro.props.lang ?? getLangFromPath(pathname);
const t = ui[lang];

// 导航文案与地址都随语言走：中文页 -> 中文路径，英文页 -> /en/ 前缀
const navItems = [
  { path: '/', label: t.nav.home },
  { path: '/about/', label: t.nav.about },
  { path: '/blog/', label: t.nav.blog },
  { path: '/projects/', label: t.nav.projects },
].map((item) => ({ ...item, href: withLang(item.path, lang) }));

// 当前高亮在「去掉语言前缀」的路径上判断，中英两套导航共用同一份逻辑
const bare = stripLang(pathname);

function isCurrent(path: string): boolean {
  if (path === '/') {
    return bare === '/';
  }
  return bare === path || bare.startsWith(path);
}

const homeHref = withLang('/', lang);
---

<header class="site-header lg lg-header lg-refract">
  <div class="container header-inner">
    <a class="site-title" href={homeHref}>{t.siteName}</a>

    <div class="header-actions">
      <nav class="site-nav" aria-label={t.navLabel}>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a
                  class="lg lg-pillbtn lg-refract"
                  href={item.href}
                  aria-current={isCurrent(item.path) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-toggles">
        <LangSwitch lang={lang} pathname={pathname} altHref={Astro.props.altHref} />
        {/* 主题切换按 ADR-12 静默：开关为 false 时不渲染；ThemeToggle.astro、其内联脚本
            与 global.css 的两处深色令牌都完整保留，把 config.ts 的开关改回 true 即恢复。 */}
        {THEME_TOGGLE_ENABLED && <ThemeToggle lang={lang} />}
        <BackgroundButton lang={lang} poolSize={BACKGROUND_IDS.length} />
      </div>

    </div>
  </div>
</header>

<style>
  /* 粘性页头：材质与形状来自 global.css 的 .lg .lg-header .lg-refract（ADR-11），
   * 这里只管定位、内部排布与导航项的排版。 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    padding-block: 0.75rem;
  }

  .site-title {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: var(--fg);
    text-shadow: 0 1px 3px rgba(6, 12, 22, 0.45);
  }

  /* 导航与右侧两个切换按钮同组，窄屏时整组换行（避免撑出横向滚动） */
  .header-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem 0.75rem;
    min-width: 0;
  }

  .header-toggles {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 材质（药丸玻璃）由 .lg .lg-pillbtn .lg-refract 提供，这里只管排版 */
  .site-nav a {
    display: block;
    padding: 0.25rem 0.8rem;
    font-size: 0.9rem;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--fg);
  }

  .site-nav a[aria-current='page'] {
    color: var(--fg);
    font-weight: 600;
  }

  /* 窄屏不留白浪费：品牌与导航各占一行时左对齐堆叠 */
  @media (max-width: 640px) {
    .header-inner {
      padding-block: 0.6rem;
    }

    .site-nav a {
      padding: 0.2rem 0.65rem;
      font-size: 0.86rem;
    }
  }
</style>
