---
/**
 * 中英文切换按钮（决策见 PLAN.md **ADR-10**）。
 *
 * 与 csdiy.wiki 一致：语言切换是**真实链接**，不是 JS 换字。
 * 中文页显示 `EN` → 去 `/en/...`；英文页显示 `中` → 回中文站。
 * 因此本按钮**零 JS**，也完全不依赖 ThemeToggle 的脚本。
 *
 * `altHref`：当目标语言没有对应页面时（例如某篇博客暂无英文版），
 * 由调用方显式给出回退地址，避免死链（ADR-10 约束 1）。
 */
import { langSwitchInfo, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 当前路径，通常传 Astro.url.pathname */
  pathname: string;
  /** 覆盖目标地址（用于目标语言缺少对应内容的场景） */
  altHref?: string;
}

const { lang, pathname, altHref } = Astro.props;
const info = langSwitchInfo(pathname, lang, altHref);
const t = ui[lang].langSwitch;
---

<a
  class="toggle-btn lang-toggle"
  href={info.href}
  hreflang={info.hreflang}
  lang={info.hreflang === 'en' ? 'en' : 'zh-CN'}
  aria-label={t.ariaLabel}
  title={t.title}>{info.label}</a
>
