---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const href = `/blog/${post.id}/`;
---

<article class="glass card post-card">
  <h3 class="post-card-title">
    <a href={href}>{title}</a>
  </h3>
  <p class="post-card-meta">
    <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('zh-CN')}</time>
  </p>
  <p class="post-card-description">{description}</p>
  {
    tags.length > 0 && (
      <ul class="pill-row post-card-tags">
        {tags.map((tag) => (
          <li class="pill">{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  /* 卡片材质来自全局 .glass + .card（P3 / ADR-7），此处只管卡片内部排版 */
  .post-card {
    min-width: 0;
  }

  .post-card-title {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }

  .post-card-title a {
    color: var(--fg);
    text-decoration: none;
  }

  .post-card-title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .post-card-meta {
    margin: 0 0 0.4rem;
    color: var(--fg-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .post-card-description {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
  }

  .post-card-tags {
    margin-top: 0.75rem;
  }
</style>
