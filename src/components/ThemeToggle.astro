---
/**
 * 浅色 / 深色切换按钮（决策见 PLAN.md **ADR-9**）。
 *
 * 机制借鉴 jh3y《Night && Day Toggle》—— CodePen `LYgjpYZ`：
 *   https://codepen.io/jh3y/pen/LYgjpYZ
 *   CodePen 公开 pen 默认 MIT 许可 © jh3y；本组件只采用其
 *   「真实 <button aria-pressed> + 一个 0/1 的 --dark 变量由 calc() 驱动过渡」机制，
 *   未使用其视觉素材（理由见 ADR-9：那个开关是 hero 级尺寸且带全局 body 样式）。
 *
 * 行为（与 csdiy.wiki 一致）：
 *   - 默认跟随系统（CSS 侧由 prefers-color-scheme 兜底，无需 JS）
 *   - 点击后锁定选择并写入 localStorage，跨页面 / 刷新保持
 *
 * 脚本必须 is:inline：Astro 默认会把 <script> 打包成模块并产出 .js 文件，
 * 那会同时打破 R3（dist 内 .js 计数为 0）与「首屏渲染前应用」的时序。
 * is:inline 的内容不做模板插值，故文案经 data-* 属性传入。
 */
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].themeSwitch;
---

<button
  id="theme-toggle"
  class="toggle-btn theme-toggle"
  type="button"
  aria-pressed="false"
  aria-label={t.toDark}
  title={t.toDark}
  data-label-to-dark={t.toDark}
  data-label-to-light={t.toLight}
>
  <span class="icon-stack">
    <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M20.75 14.62A8.75 8.75 0 0 1 9.38 3.25a8.75 8.75 0 1 0 11.37 11.37Z"
        fill="currentColor"></path>
    </svg>
    <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="4.1" fill="currentColor"></circle>
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <path
          d="M12 2.4v2.2M12 19.4v2.2M2.4 12h2.2M19.4 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"
        ></path>
      </g>
    </svg>
  </span>
</button>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;

    // 与 global.css 的 --bg-color 保持一致（浅 #eaf1fb / 暗 #0b1020）
    var THEME_COLOR = { light: '#eaf1fb', dark: '#0b1020' };
    var mq = window.matchMedia('(prefers-color-scheme: dark)');

    // 有效主题 = 手动选择优先，否则跟随系统
    function effective() {
      var saved = root.getAttribute('data-theme');
      if (saved === 'light' || saved === 'dark') return saved;
      return mq.matches ? 'dark' : 'light';
    }

    // 一旦有手动选择，两条 media 版 theme-color 就不准了，换成单一 meta
    function syncThemeColor(theme) {
      if (!root.hasAttribute('data-theme')) return;
      var metas = document.querySelectorAll('meta[name="theme-color"]');
      for (var i = 0; i < metas.length; i++) {
        if (metas[i].hasAttribute('media')) metas[i].remove();
      }
      var meta = document.querySelector('meta[name="theme-color"]:not([media])');
      if (!meta) {
        meta = document.createElement('meta');
        meta.setAttribute('name', 'theme-color');
        document.head.appendChild(meta);
      }
      meta.setAttribute('content', THEME_COLOR[theme]);
    }

    function paint() {
      var theme = effective();
      var isDark = theme === 'dark';
      var label = isDark
        ? btn.getAttribute('data-label-to-light')
        : btn.getAttribute('data-label-to-dark');
      btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
      syncThemeColor(theme);
    }

    // 同步执行：此时尚未首屏渲染，不会出现图标闪烁
    paint();

    btn.addEventListener('click', function () {
      var next = effective() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        window.localStorage.setItem('theme', next);
      } catch (e) {
        /* 隐私模式等场景下 localStorage 不可用：本次会话内仍然生效 */
      }
      paint();
    });

    // 没有手动选择时跟随系统（配色由 CSS 自动切换，这里只同步按钮状态与 theme-color）
    var onSystemChange = function () {
      if (!root.hasAttribute('data-theme')) paint();
    };
    if (mq.addEventListener) mq.addEventListener('change', onSystemChange);
    else if (mq.addListener) mq.addListener(onSystemChange);

    // 兜底重绘：极少数环境下（实测见于无头 Chromium）内联脚本执行时
    // prefers-color-scheme 尚未解析完成，matchMedia 会返回过期的值，导致 CSS 已是深色
    // 而按钮仍显示「切换到深色」。load 后再同步一次，保证按钮状态与真实配色一致。
    window.addEventListener('load', paint);
  })();
</script>

<style>
  /* --dark 是 0/1 的数值变量，由 aria-pressed 驱动，所有过渡用 calc() 计算
     —— 即 ADR-9 采纳自 jh3y 的机制 */
  .theme-toggle {
    --dark: 0;
  }

  .theme-toggle[aria-pressed='true'] {
    --dark: 1;
  }

  .icon-stack {
    display: grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
  }

  .icon {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    /* 与 jh3y 原始 pen 相同的缓动曲线 */
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.4, -0.3, 0.6, 1.3);
  }

  .icon-moon {
    opacity: calc(1 - var(--dark));
    transform: rotate(calc(var(--dark) * 90deg)) scale(calc(1 - var(--dark) * 0.45));
  }

  .icon-sun {
    opacity: var(--dark);
    transform: rotate(calc(var(--dark) * -90deg)) scale(calc(0.55 + var(--dark) * 0.45));
  }

  @media (prefers-reduced-motion: reduce) {
    .icon {
      transition: none;
    }
  }
</style>
