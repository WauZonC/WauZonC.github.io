---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromPath, HTML_LANG, ui, withLang, type Lang } from '../i18n/ui';
import { THEME_GATE_CLASS } from '../backgrounds/runtime';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** 缺省按路径自动判断（`/en/` 前缀 = 英文） */
  lang?: Lang;
  /**
   * 语言按钮的目标地址。
   * - 语言镜像页（首页 / 关于 / 博客列表 / 项目 / 404）不用传，会自动推导为同路径的另一语言
   * - 目标语言没有对应内容时（如某篇博客暂无英文版）必须传回退地址 + `translated={false}`，避免死链
   */
  altHref?: string;
  /**
   * 另一语言是否存在**同一页面**的 1:1 译文。默认 `true`（语言镜像页）。
   * 为 `false` 时只输出 x-default，不输出双向 hreflang（ADR-10 约束 2）。
   */
  translated?: boolean;
}

const pathname = Astro.url.pathname;
const lang: Lang = Astro.props.lang ?? getLangFromPath(pathname);
const t = ui[lang];

const {
  title = t.defaultTitle,
  description = t.defaultDescription,
  ogType = 'website',
  altHref,
  translated = true,
} = Astro.props;

const target: Lang = lang === 'zh' ? 'en' : 'zh';
const buttonHref = altHref ?? withLang(pathname, target);
// 只有确实存在 1:1 译文时才把地址交给 BaseHead 输出双向 hreflang
const counterpartHref = translated ? buttonHref : undefined;
---

<!doctype html>
<!--
  `gate-dark` 是主题静默门控（ADR-12 / M-4）：只有 config.ts 的 THEME_TOGGLE_ENABLED
  为 true 时才加这个类。未加时 global.css 里 `@media (prefers-color-scheme: dark)`
  那条深色令牌**不生效**，站点恒定浅色 —— 也就是「保留代码、静默、保持浅色」。
-->
<html lang={HTML_LANG[lang]} class={THEME_GATE_CLASS || undefined}>
  <head>
    <BaseHead
      title={title}
      description={description}
      ogType={ogType}
      lang={lang}
      altHref={counterpartHref}
    />
  </head>
  <body>
    <!--
      背景照片的两个固定层（ADR-12 / M-4）。两层初值是**同一张图**（层 2 在 global.css 里
      刻意重复了一次），所以交叉淡入的任意时刻都至少有一层是有图的，不会露出纯色底。
      这里**不写 style 属性**：`--bg-photo` 由 BaseHead 的内联 <style>（构建期当日照片）
      与运行期脚本（客户端当日照片）负责，两边写法保持一致才不会漂移。
      两层的 `--photo-dim` 会随主题令牌变化，因此深色令牌保留也不会影响它们。
    -->
    <div class="bg-layer bg-layer-front" data-active="true" aria-hidden="true"></div>
    <div class="bg-layer bg-layer-back" data-active="false" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header lang={lang} altHref={buttonHref} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  /* 玻璃拟态风格下，主区域与页头/页脚之间留出呼吸感（见 PLAN.md ADR-7） */
  main {
    padding-block: 2.25rem 3rem;
  }

  @media (max-width: 640px) {
    main {
      padding-block: 1.5rem 2.25rem;
    }
  }
</style>
