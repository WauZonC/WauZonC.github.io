---
import BaseLayout from './BaseLayout.astro';
import { ui, withLang, type Lang } from '../i18n/ui';
import type { BlogEntry } from '../content-types';

interface Props {
  post: BlogEntry;
  lang?: Lang;
  /**
   * 另一语言是否存在**同 slug 的译文**。
   * 决定 hreflang 是否输出、以及语言按钮是跳到对应文章还是退回列表页（ADR-10 约束 1）。
   */
  hasTranslation?: boolean;
}

const { post, hasTranslation = false } = Astro.props;
const lang: Lang = Astro.props.lang ?? 'zh';
const t = ui[lang];

const { title, description, pubDate, updatedDate, tags } = post.data;

const listHref = withLang('/blog/', lang);
const target: Lang = lang === 'zh' ? 'en' : 'zh';
const counterpartHref = withLang(`/blog/${post.id}/`, target);
// 没有译文时，语言按钮必须落到**目标语言**的列表页。
// （曾经误用 listHref = 当前语言的列表页，结果按钮指向用户已经在看的页面，等于点了没反应。）
const fallbackHref = withLang('/blog/', target);
const dateLocale = t.dateLocale;
---

<BaseLayout
  title={`${title} | ${t.siteName}`}
  description={description}
  ogType="article"
  lang={lang}
  altHref={hasTranslation ? counterpartHref : fallbackHref}
  translated={hasTranslation}
>
  <article class="panel measure lg lg-panel lg-refract">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString(dateLocale)}</time>
        {
          updatedDate && (
            <>
              <span class="sep">·</span>
              <span>
                {t.updatedOn} {updatedDate.toLocaleDateString(dateLocale)}
              </span>
            </>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="pill-row post-tags">
            {tags.map((tag) => (
              <li class="pill lg lg-pillbtn lg-refract">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose post-body">
      <slot />
    </div>
  </article>

  <p class="post-back measure"><a href={listHref}>{t.backToList}</a></p>
</BaseLayout>

<style>
  /* 文章页：玻璃面板 + .prose 正文排版，面板与返回链接同宽（.measure） */
  .post-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .post-header h1 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.6rem, 4.6vw, 2.3rem);
  }

  .post-meta {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .sep {
    margin: 0 0.4rem;
  }

  .post-tags {
    margin-top: 0.75rem;
  }

  .post-back {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }
</style>
