---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 页面未找到 | WauZonC" description="请求的页面不存在。">
  <section class="glass panel measure error-panel">
    <h1>404 · 页面未找到</h1>
    <p>你访问的页面不存在，或者已经被移动了。</p>
    <p class="error-links">
      <a href="/">返回首页</a>
      <span class="sep">·</span>
      <a href="/blog/">浏览文章</a>
    </p>
  </section>
</BaseLayout>

<style>
  .error-panel {
    text-align: center;
    padding-block: 3rem;
  }

  .error-panel h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.5rem, 4.4vw, 2.1rem);
  }

  .error-panel p {
    margin: 0;
    color: var(--fg-muted);
  }

  .error-links {
    margin-top: 1.25rem;
  }

  .sep {
    margin: 0 0.4rem;
    color: var(--fg-muted);
  }

  @media (max-width: 640px) {
    .error-panel {
      padding-block: 2rem;
    }
  }
</style>
