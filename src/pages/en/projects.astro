---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import LangNotice from '../../components/LangNotice.astro';
import { ui } from '../../i18n/ui';

const t = ui.en;

const projects = (await getCollection('projectsEn')).sort(
  (a, b) => b.data.order - a.data.order || a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  lang="en"
  title={`Projects | ${t.siteName}`}
  description="WauZonC's projects and portfolio."
  altHref="/projects/"
>
  <div class="page-head">
    <h1>Projects</h1>
    <p>{projects.length} {projects.length === 1 ? 'entry' : 'entries'}.</p>
  </div>

  {
    projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} lang="en" />
        ))}
      </div>
    ) : (
      <LangNotice zhHref="/projects/" />
    )
  }
</BaseLayout>
